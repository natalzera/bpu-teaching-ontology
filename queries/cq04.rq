# CQ4: How many course offerings does each department have in term 2026/1?
# Reasoning: REQUIRED for the UFMG and USP rows (subclass inference to University).
# Counts recorded offerings only (open world).
PREFIX bpu:     <https://example.org/bpu#>
PREFIX foaf:    <http://xmlns.com/foaf/0.1/>
PREFIX org:     <http://www.w3.org/ns/org#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:     <http://www.w3.org/2001/XMLSchema#>

SELECT ?departmentName ?universityName (COUNT(DISTINCT ?offering) AS ?offerings)
WHERE {
  ?offering a bpu:CourseOffering ;
            bpu:heldInTerm ?term ;
            bpu:ofCourse   ?course .
  ?term   bpu:termCode "2026/1" .
  ?course bpu:responsibleUnit ?department .
  ?department foaf:name ?departmentName ;
              org:subOrganizationOf+ ?university .
  ?university a bpu:University ;
              foaf:name ?universityName .
}
GROUP BY ?department ?departmentName ?universityName
ORDER BY ?departmentName
