# CQ5: Who teaches course COMP-DB in term 2026/1, and in which lecturer role?
# Reasoning: not required.
PREFIX bpu:     <https://example.org/bpu#>
PREFIX foaf:    <http://xmlns.com/foaf/0.1/>
PREFIX org:     <http://www.w3.org/ns/org#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:     <http://www.w3.org/2001/XMLSchema#>

SELECT ?personName ?roleLabel
WHERE {
  ?course bpu:courseCode "COMP-DB" .
  ?offering bpu:ofCourse ?course ;
            bpu:heldInTerm ?term .
  ?term bpu:termCode "2026/1" .
  ?assignment bpu:assignedOffering ?offering ;
              bpu:assignedPerson   ?person ;
              bpu:assignmentRole   ?role .
  VALUES ?role { bpu:lead-lecturer-role bpu:co-lecturer-role }
  ?person foaf:name ?personName .
  ?role rdfs:label ?roleLabel .
  FILTER (lang(?roleLabel) = "en")
}
ORDER BY ?personName
