# CQ2: Which universities are federal universities?
# Reasoning: REQUIRED. bpu:FederalUniversity is a defined class
# (University and maintainedBy value uniao-federal). UFSCar has no asserted type.
PREFIX bpu:     <https://example.org/bpu#>
PREFIX foaf:    <http://xmlns.com/foaf/0.1/>
PREFIX org:     <http://www.w3.org/ns/org#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:     <http://www.w3.org/2001/XMLSchema#>

SELECT ?name
WHERE {
  ?university a bpu:FederalUniversity ;
              foaf:name ?name .
}
ORDER BY ?name
