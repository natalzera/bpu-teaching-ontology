@prefix bpu:     <https://example.org/bpu#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf:    <http://xmlns.com/foaf/0.1/> .
@prefix org:     <http://www.w3.org/ns/org#> .

# SYNTHETIC TEST DATA (licence: CC0).
# University names are real. People, courses, offerings, hours and term dates
# are invented and do not describe real people or real schedules.
#
# This file has no ontology header and no owl:imports; it is merged with
# ontology.ttl by the check scripts (see scripts/run_checks.sh).

###############################################################################
# Government bodies (bpu:uniao-federal is declared in ontology.ttl)
###############################################################################

bpu:estado-de-sao-paulo a bpu:GovernmentBody ;
    foaf:name "Estado de São Paulo" .

###############################################################################
# Universities
###############################################################################

# NOTE: no FederalUniversity type is asserted for UFSCar. A reasoner infers it
# from maintainedBy bpu:uniao-federal (defined class, CQ2 and CQ6).
bpu:ufscar a bpu:University ;
    foaf:name "Universidade Federal de São Carlos" ;
    bpu:maintainedBy bpu:uniao-federal .

# Asserted federal university (control case).
bpu:ufmg a bpu:FederalUniversity ;
    foaf:name "Universidade Federal de Minas Gerais" ;
    bpu:maintainedBy bpu:uniao-federal .

# State university.
bpu:usp a bpu:StateUniversity ;
    foaf:name "Universidade de São Paulo" ;
    bpu:maintainedBy bpu:estado-de-sao-paulo .

###############################################################################
# Departments
###############################################################################

bpu:ufscar-dc a bpu:Department ;
    foaf:name "Departamento de Computação" ;
    org:subOrganizationOf bpu:ufscar .

bpu:ufscar-dm a bpu:Department ;
    foaf:name "Departamento de Matemática" ;
    org:subOrganizationOf bpu:ufscar .

bpu:ufmg-dcc a bpu:Department ;
    foaf:name "Departamento de Ciência da Computação" ;
    org:subOrganizationOf bpu:ufmg .

bpu:usp-cc a bpu:Department ;
    foaf:name "Departamento de Ciências de Computação" ;
    org:subOrganizationOf bpu:usp .

###############################################################################
# Courses (catalogue entries)
###############################################################################

bpu:course-ufscar-comp-oe a bpu:Course ;
    dcterms:title "Ontology Engineering" ;
    bpu:courseCode "COMP-OE" ;
    bpu:responsibleUnit bpu:ufscar-dc .

bpu:course-ufscar-comp-db a bpu:Course ;
    dcterms:title "Databases" ;
    bpu:courseCode "COMP-DB" ;
    bpu:responsibleUnit bpu:ufscar-dc .

bpu:course-ufscar-mat-la a bpu:Course ;
    dcterms:title "Linear Algebra" ;
    bpu:courseCode "MAT-LA" ;
    bpu:responsibleUnit bpu:ufscar-dm .

bpu:course-ufmg-dcc-db a bpu:Course ;
    dcterms:title "Databases" ;
    bpu:courseCode "DCC-DB" ;
    bpu:responsibleUnit bpu:ufmg-dcc .

bpu:course-usp-scc-kr a bpu:Course ;
    dcterms:title "Knowledge Representation" ;
    bpu:courseCode "SCC-KR" ;
    bpu:responsibleUnit bpu:usp-cc .

###############################################################################
# Academic terms
###############################################################################

bpu:term-2026-1 a bpu:AcademicTerm ;
    bpu:termCode "2026/1" ;
    bpu:startDate "2026-03-02"^^xsd:date ;
    bpu:endDate   "2026-07-11"^^xsd:date .

bpu:term-2026-2 a bpu:AcademicTerm ;
    bpu:termCode "2026/2" ;
    bpu:startDate "2026-08-03"^^xsd:date ;
    bpu:endDate   "2026-12-12"^^xsd:date .

###############################################################################
# Course offerings
###############################################################################

bpu:off-ufscar-comp-oe-2026-1 a bpu:CourseOffering ;
    bpu:ofCourse bpu:course-ufscar-comp-oe ;
    bpu:heldInTerm bpu:term-2026-1 .

bpu:off-ufscar-comp-oe-2026-2 a bpu:CourseOffering ;
    bpu:ofCourse bpu:course-ufscar-comp-oe ;
    bpu:heldInTerm bpu:term-2026-2 .

bpu:off-ufscar-comp-db-2026-1 a bpu:CourseOffering ;
    bpu:ofCourse bpu:course-ufscar-comp-db ;
    bpu:heldInTerm bpu:term-2026-1 .

bpu:off-ufscar-mat-la-2026-1 a bpu:CourseOffering ;
    bpu:ofCourse bpu:course-ufscar-mat-la ;
    bpu:heldInTerm bpu:term-2026-1 .

bpu:off-ufmg-dcc-db-2026-1 a bpu:CourseOffering ;
    bpu:ofCourse bpu:course-ufmg-dcc-db ;
    bpu:heldInTerm bpu:term-2026-1 .

bpu:off-usp-scc-kr-2026-1 a bpu:CourseOffering ;
    bpu:ofCourse bpu:course-usp-scc-kr ;
    bpu:heldInTerm bpu:term-2026-1 .

###############################################################################
# People (no "Lecturer" class: lecturing is a role played through assignments)
###############################################################################

bpu:ana   a foaf:Person ; foaf:name "Ana Silva" .
bpu:bruno a foaf:Person ; foaf:name "Bruno Costa" .
bpu:carla a foaf:Person ; foaf:name "Carla Souza" .
bpu:diego a foaf:Person ; foaf:name "Diego Lima" .
bpu:eva   a foaf:Person ; foaf:name "Eva Rocha" .

###############################################################################
# Teaching assignments (participation / role pattern)
###############################################################################

bpu:asg-ana-comp-oe-2026-1 a bpu:TeachingAssignment ;
    bpu:assignedPerson bpu:ana ;
    bpu:assignedOffering bpu:off-ufscar-comp-oe-2026-1 ;
    bpu:assignmentRole bpu:lead-lecturer-role ;
    bpu:weeklyHours 4 .

bpu:asg-ana-comp-db-2026-1 a bpu:TeachingAssignment ;
    bpu:assignedPerson bpu:ana ;
    bpu:assignedOffering bpu:off-ufscar-comp-db-2026-1 ;
    bpu:assignmentRole bpu:lead-lecturer-role ;
    bpu:weeklyHours 4 .

bpu:asg-bruno-comp-db-2026-1 a bpu:TeachingAssignment ;
    bpu:assignedPerson bpu:bruno ;
    bpu:assignedOffering bpu:off-ufscar-comp-db-2026-1 ;
    bpu:assignmentRole bpu:co-lecturer-role ;
    bpu:weeklyHours 2 .

bpu:asg-ana-comp-oe-2026-2 a bpu:TeachingAssignment ;
    bpu:assignedPerson bpu:ana ;
    bpu:assignedOffering bpu:off-ufscar-comp-oe-2026-2 ;
    bpu:assignmentRole bpu:lead-lecturer-role ;
    bpu:weeklyHours 4 .

bpu:asg-bruno-mat-la-2026-1 a bpu:TeachingAssignment ;
    bpu:assignedPerson bpu:bruno ;
    bpu:assignedOffering bpu:off-ufscar-mat-la-2026-1 ;
    bpu:assignmentRole bpu:lead-lecturer-role ;
    bpu:weeklyHours 4 .

bpu:asg-carla-dcc-db-2026-1 a bpu:TeachingAssignment ;
    bpu:assignedPerson bpu:carla ;
    bpu:assignedOffering bpu:off-ufmg-dcc-db-2026-1 ;
    bpu:assignmentRole bpu:lead-lecturer-role ;
    bpu:weeklyHours 4 .

bpu:asg-diego-scc-kr-2026-1 a bpu:TeachingAssignment ;
    bpu:assignedPerson bpu:diego ;
    bpu:assignedOffering bpu:off-usp-scc-kr-2026-1 ;
    bpu:assignmentRole bpu:lead-lecturer-role ;
    bpu:weeklyHours 4 .

bpu:asg-eva-comp-oe-2026-1 a bpu:TeachingAssignment ;
    bpu:assignedPerson bpu:eva ;
    bpu:assignedOffering bpu:off-ufscar-comp-oe-2026-1 ;
    bpu:assignmentRole bpu:teaching-assistant-role ;
    bpu:weeklyHours 2 .
